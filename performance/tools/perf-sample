#!/usr/bin/env python3
import argparse
import csv
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import perf  # noqa: E402

DESCRIPTION = '''Sample CPU, memory, swap and GPU memory of processes over time, as CSV.

Every interval it reads, for each matching process:
  cpu_pct            utime+stime from /proc/<pid>/stat over the interval, as % of one core
  private_dirty_kib  memory only this process wrote: the number to quote
  pss_kib            proportional share, counting shared libraries fairly
  rss_kib            kept for comparison with old rows; do not quote it
  swap_kib           this process's pages in swap
  gpu_kib            drm-total-* from the DRM fdinfo of /dev/dri fds; on an
                     integrated GPU this is system RAM too, and is NOT in RSS
  threads, fds       growth here is a leak of its own kind
  read_kib_s         rchar from /proc/<pid>/io over the interval: every byte
                     read(2) returned, page cache or not
  write_kib_s        wchar, likewise
and the machine's MemAvailable.

Processes are matched by exact comm name (--name), by pid (--pid), or by a
pid and all its descendants (--tree), re-resolved every tick so a process
that starts or restarts mid-run is picked up.'''


def fmt(v):
    return '' if v is None else '%.1f' % v


def main():
    ap = argparse.ArgumentParser(description=DESCRIPTION, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('--name', action='append', default=[], help='exact process name to sample, repeatable (e.g. botropolisd)')
    ap.add_argument('--pid', action='append', type=int, default=[], help='pid to sample, repeatable')
    ap.add_argument('--tree', action='append', type=int, default=[], help='pid to sample with every descendant, repeatable')
    ap.add_argument('--interval', type=float, default=2.0, help='seconds between samples (default 2)')
    ap.add_argument('--duration', type=float, default=300.0, help='seconds to sample for (default 300); 0 runs until interrupted')
    ap.add_argument('--until-idle', type=float, default=0, help='stop early once every sampled process has stayed under 1%% CPU for this many seconds')
    ap.add_argument('--out', default='-', help='CSV file to write (default stdout)')
    args = ap.parse_args()
    if not (args.name or args.pid or args.tree):
        ap.error('give at least one of --name, --pid, --tree')

    clk = os.sysconf('SC_CLK_TCK')
    out = sys.stdout if args.out == '-' else open(args.out, 'w', newline='')
    writer = csv.DictWriter(out, fieldnames=perf.SAMPLE_FIELDS)
    writer.writeheader()

    def targets():
        found = set(args.pid) | perf.pids_named(set(args.name))
        for root in args.tree:
            found |= perf.proc_tree(root)
        return found

    start = time.monotonic()
    idle = perf.IdleClock(threshold_pct=1.0, needed_s=args.until_idle)
    last = {pid: (perf.proc_ticks(pid), perf.proc_io(pid), start) for pid in targets()}
    try:
        while True:
            time.sleep(args.interval)
            now = time.monotonic()
            elapsed = now - start
            avail = perf.mem_available_kib()
            current = targets()
            busiest = 0.0
            for pid in sorted(current):
                ticks = perf.proc_ticks(pid)
                if ticks is None:
                    continue
                io = perf.proc_io(pid)
                before, io_before, then = last.get(pid, (ticks, io, now))
                snap = perf.proc_snapshot(pid)
                writer.writerow({
                    'ts': time.strftime('%Y-%m-%dT%H:%M:%S'),
                    'elapsed_s': '%.1f' % elapsed,
                    'pid': pid,
                    'comm': perf.proc_comm(pid),
                    'cpu_pct': '%.2f' % perf.cpu_percent(before, ticks, clk, now - then),
                    'read_kib_s': fmt(perf.rate_kib_s(io_before.get('rchar'), io.get('rchar'), now - then)),
                    'write_kib_s': fmt(perf.rate_kib_s(io_before.get('wchar'), io.get('wchar'), now - then)),
                    'mem_available_kib': avail,
                    **snap,
                })
                last[pid] = (ticks, io, now)
                busiest = max(busiest, perf.cpu_percent(before, ticks, clk, now - then))
            out.flush()
            idle.observe(elapsed, busiest)
            if args.until_idle and idle.idle():
                print('# idle for %ds at %.0fs' % (args.until_idle, elapsed), file=sys.stderr)
                break
            if args.duration and elapsed >= args.duration:
                break
    except KeyboardInterrupt:
        pass
    finally:
        if out is not sys.stdout:
            out.close()


if __name__ == '__main__':
    main()
