#!/usr/bin/env bash
set -uo pipefail

here=$(cd "$(dirname "$(realpath "$0")")" && pwd)
# shellcheck source=performance/tools/lib/procgroup.sh
. "${here}/lib/procgroup.sh"
procgroup_lead "$@"
repo=$(cd "${here}/../.." && pwd)

writers=2
seconds=480
profile_from=120
profile_seconds=300
scenario=hamlet
interval=1
hide_after=0
keep_focus=0
out=""
build=""

usage() {
	cat <<USAGE
Usage: performance/tools/perf-busy-city [options] BUILD_DIR

A city on a busy desk, made repeatable (performance/method.md, run 6).
BUILD_DIR holds botropolis and botropolisd, as perf-pprof-build makes them.

A scratch home is staged from a demo scenario, and every transcript, session
record and history.jsonl under ~/.claude is linked into it read only, by
symlink: nothing of ~/.claude is copied, and nothing of it is ever written.
A daemon of the build runs with HOME set to that scratch home and every XDG
directory inside the run's scratch tree, so it opens a statistics store as a
production daemon does (one given --home opens none, item 165) and nothing of
the caller's state, config, cache or data is touched. Once its CPU has been
idle for 20 s (at most PERF_BUSY_SETTLE s, default 600), the city
opens on the real display, and from 25 s WRITERS of the demo's own live
sessions each write a user line every 200 ms. The run is sampled with
perf-city; the city's CPU is profiled when the build has a pprof endpoint.

  --writers N            sessions writing (default: ${writers})
  --seconds N            how long to sample (default: ${seconds})
  --profile-from N       start the CPU profile N s in (default: ${profile_from})
  --profile-seconds N    profile length (default: ${profile_seconds}); 0 takes no profile
  --scenario NAME        demo scenario to stage (default: ${scenario})
  --interval N           seconds between samples (default: ${interval})
  --hide-after N         hide the window N s in, as perf-city does (default: never)
  --keep-focus           leave the city focused rather than handing the focus back,
                         so the run until the hide measures a city that draws
  --out DIR              run directory (default: a new one under \$XDG_STATE_HOME/botropolis-perf)
  -h, --help             this

Optional steps, each recorded in busy.txt and said aloud when skipped:
  - the focus hand-back, which needs i3-msg and xprop: the city takes the focus
    for 20 s and gives it back, so the rest is a visible, unfocused city;
    without them the window keeps whatever focus the desktop gave it;
  - whether the monitor was on, which needs xset: a locked screen keeps the
    focus from every window;
  - the CPU profile, which needs a build made by perf-pprof-build.

Run it under the landing lock, one build after another.

For tests: BOTROPOLIS_DEMO names a demo stager to use instead of building one,
PERF_BUSY_SETTLE=0 skips the settle, PERF_BUSY_REPLAY_FROM moves the replay's
start (default 25 s), and PERF_BUSY_PPROF_WAIT is how many 0.2 s tries the
pprof check takes (default 50).
USAGE
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	--writers) writers="$2"; shift 2 ;;
	--seconds) seconds="$2"; shift 2 ;;
	--profile-from) profile_from="$2"; shift 2 ;;
	--profile-seconds) profile_seconds="$2"; shift 2 ;;
	--scenario) scenario="$2"; shift 2 ;;
	--interval) interval="$2"; shift 2 ;;
	--hide-after) hide_after="$2"; shift 2 ;;
	--keep-focus) keep_focus=1; shift ;;
	--out) out="$2"; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	-*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
	*) build="$1"; shift ;;
	esac
done
[[ -n "${build}" ]] || { usage >&2; exit 2; }
build=$(cd "${build}" && pwd)
for bin in botropolis botropolisd; do
	[[ -x "${build}/${bin}" ]] || { echo "no ${bin} in ${build}" >&2; exit 1; }
done

out="${out:-${XDG_STATE_HOME:-$HOME/.local/state}/botropolis-perf/busy-$(date +%Y%m%d-%H%M%S)}"
mkdir -p "${out}"
note() { echo "$1" >>"${out}/busy.txt"; }
say() { echo "# $1" >&2; }

work=$(mktemp -d)
home="${work}/home"
pids=()
building=""
cleanup() {
	for p in "${pids[@]}" ${building:+"${building}"}; do kill "${p}" 2>/dev/null || true; done
	wait 2>/dev/null || true
	[[ -x "${work}/botropolis-demo" ]] && "${work}/botropolis-demo" unstage --home "${home}" >/dev/null 2>&1
	rm -rf "${work}"
}
procgroup_on_exit cleanup

src="${build}/src"
[[ -d "${src}/cmd/botropolis-demo" ]] || src="${repo}/botropolis"
if [[ -n "${BOTROPOLIS_DEMO:-}" ]]; then
	cp "${BOTROPOLIS_DEMO}" "${work}/botropolis-demo"
else
	go -C "${src}" build -o "${work}/botropolis-demo" ./cmd/botropolis-demo &
	building=$!
	wait "${building}" || { echo "could not build the demo stager from ${src}" >&2; exit 1; }
	building=""
fi
corpus="${repo}/botropolis/demo"
[[ -d "${src}/demo/corpus" ]] && corpus="${src}/demo"
hold="$((seconds + 3600))s"
"${work}/botropolis-demo" stage --corpus "${corpus}/corpus" --scenario "${corpus}/scenarios/${scenario}.yaml" --home "${home}" --hold "${hold}" >/dev/null ||
	{ echo "could not stage ${scenario}" >&2; exit 1; }
python3 -I "${here}/perf.py" busy-home "${HOME}/.claude" "${home}" || exit 1
note "scenario=${scenario} writers=${writers} every_ms=200 seconds=${seconds}"
note "demo_hold=${hold}"
note "linked_transcripts=$(find "${home}/.claude/projects" -type l -name '*.jsonl' | wc -l) scratch_transcripts=$(find "${home}/.claude/projects" -type f -name '*.jsonl' | wc -l)"

mkdir -p "${work}/state" "${work}/run/botropolis" "${work}/config/botropolis" "${work}/cache" "${work}/data" "${work}/stub"
printf '#!/bin/sh\nexit 1\n' >"${work}/stub/claude"
chmod +x "${work}/stub/claude"
config="${XDG_CONFIG_HOME:-$HOME/.config}/botropolis/config.toml"
[[ -f "${config}" ]] && cp "${config}" "${work}/config/botropolis/config.toml"
sock="${work}/run/botropolis/botropolis.sock"
PATH="${work}/stub:${PATH}" HOME="${home}" XDG_STATE_HOME="${work}/state" XDG_RUNTIME_DIR="${work}/run" XDG_CONFIG_HOME="${work}/config" \
	XDG_CACHE_HOME="${work}/cache" XDG_DATA_HOME="${work}/data" \
	"${build}/botropolisd" --socket "${sock}" >"${out}/daemon.log" 2>&1 &
daemon=$!
pids+=("${daemon}")
note "daemon_pid=${daemon}"
for _ in $(seq 90); do [[ -S "${sock}" ]] && break; sleep 1; done
[[ -S "${sock}" ]] || { echo "the daemon did not open its socket" >&2; exit 1; }

ticks() { awk '{print $14 + $15}' "/proc/${daemon}/stat" 2>/dev/null || echo 0; }
settle_cap="${PERF_BUSY_SETTLE:-600}"
if ((settle_cap == 0)); then
	note "settle=none (PERF_BUSY_SETTLE=0)"
else
	hz=$(getconf CLK_TCK)
	settle_start=$(date +%s)
	settled=""
	while (($(date +%s) - settle_start < settle_cap)); do
		t0=$(ticks)
		sleep 20
		(($(ticks) - t0 < hz * 20 / 100)) && { settled=$(($(date +%s) - settle_start)); break; }
	done
	if [[ -n "${settled}" ]]; then
		note "settle=idle after ${settled} s"
	else
		say "the daemon was still busy after ${settle_cap} s; measuring anyway"
		note "settle=busy at ${settle_cap} s"
	fi
fi

handback=0
if [[ "${keep_focus}" == 1 ]]; then
	note "focus_handback=none (--keep-focus)"
elif command -v i3-msg >/dev/null && command -v xprop >/dev/null; then
	handback=1
	prev=$(i3-msg -t get_tree | python3 -I -c 'import json,sys
def w(n):
    if n.get("focused"): print(n["id"]); return True
    return any(w(k) for k in n.get("nodes",[])+n.get("floating_nodes",[]))
w(json.load(sys.stdin))')
else
	say "focus hand-back skipped: it needs i3-msg and xprop; the window keeps whatever focus the desktop gives it"
	note "focus_handback=skipped (no i3-msg or xprop)"
fi
if command -v xset >/dev/null; then
	note "monitor_at_start=$(xset q 2>/dev/null | grep -io 'monitor is [a-z]*' || echo unknown)"
else
	say "monitor check skipped: it needs xset"
	note "monitor=unchecked (no xset)"
fi
note "load_at_start=$(cut -d' ' -f1-3 /proc/loadavg)"

PERF_PPROF=127.0.0.1:6078 XDG_RUNTIME_DIR="${work}/run" XDG_STATE_HOME="${work}/state" XDG_CONFIG_HOME="${work}/config" \
	"${here}/perf-city" --bin "${build}/botropolis" --seconds "${seconds}" --interval "${interval}" --hide-after "${hide_after}" --out "${out}/run" -- --socket "${sock}" 2>"${out}/perf-city.err" &
city_run=$!
pids+=("${city_run}")
city=""
for _ in $(seq 300); do
	city=$(grep -oE 'city pid [0-9]+' "${out}/perf-city.err" 2>/dev/null | awk '{print $3}')
	[[ -n "${city}" ]] && break
	sleep 0.1
done
[[ -n "${city}" ]] || { echo "the city did not start; see ${out}/perf-city.err" >&2; exit 1; }
start=$(date +%s)
at() { while (($(date +%s) - start < $1)); do sleep 0.2; done; }

if [[ "${handback}" == 1 ]]; then
	window=""
	for _ in $(seq 300); do
		for id in $(i3-msg -t get_tree | python3 -I "${here}/perf.py" i3-window-ids); do
			[[ "$(xprop -id "${id}" _NET_WM_PID 2>/dev/null)" == *"= ${city}" ]] && window="${id}"
		done
		[[ -n "${window}" ]] && break
		sleep 0.1
	done
	if [[ -n "${window}" ]]; then
		i3-msg "[id=${window}] focus" >/dev/null
		at 20
		i3-msg "[con_id=${prev}] focus" >/dev/null && note "focus_handback=at 20 s"
	else
		say "focus hand-back skipped: the city's window was not found"
		note "focus_handback=skipped (window not found)"
	fi
fi

replay_from="${PERF_BUSY_REPLAY_FROM:-25}"
at "${replay_from}"
python3 -I "${here}/perf.py" replay "${home}" "${writers}" "$((seconds - replay_from))" >"${out}/replay.txt" 2>&1 &
pids+=($!)

pprof=0
if ((profile_seconds > 0)); then
	for _ in $(seq "${PERF_BUSY_PPROF_WAIT:-50}"); do curl -s -o /dev/null "http://127.0.0.1:6078/debug/pprof/" && { pprof=1; break; }; sleep 0.2; done
fi
if ((profile_seconds == 0)); then
	note "profile=none (--profile-seconds 0)"
elif [[ "${pprof}" == 1 ]]; then
	(
		at "${profile_from}"
		curl -s -o "${out}/cpu-${profile_from}-$((profile_from + profile_seconds)).pb.gz" "http://127.0.0.1:6078/debug/pprof/profile?seconds=${profile_seconds}"
		curl -s -o "${out}/heap-end.pb.gz" "http://127.0.0.1:6078/debug/pprof/heap"
	) &
	pids+=($!)
else
	say "CPU profile skipped: the build has no pprof endpoint (make it with perf-pprof-build)"
	note "profile=skipped (no pprof endpoint)"
fi

wait "${city_run}"
command -v xset >/dev/null && note "monitor_at_end=$(xset q 2>/dev/null | grep -io 'monitor is [a-z]*' || echo unknown)"
note "load_at_end=$(cut -d' ' -f1-3 /proc/loadavg)"
for p in "${pids[@]:1}"; do wait "${p}" 2>/dev/null || true; done
echo "${out}"
