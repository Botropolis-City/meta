#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<USAGE
Usage: lockdown --allow NETWORK

Shuts the soak box's ssh to everyone but the runner (item 301), first thing
after delivery and before the set-up. A box on a fresh IPv4 address is found
by ssh brute-force bots within minutes, and the rescue system's sshd, at the
default MaxStartups of 10:30:100, then drops new connections at random, the
runner's among them.

It accepts port 22 from NETWORK alone and drops it from everyone else, over
IPv4 and IPv6, with iptables-legacy and ip6tables-legacy: the rescue kernel
(6.12.67) has no nf_tables, so nft and the nft-backed iptables both fail
there. nft is used only where there is no legacy iptables. It turns off
password and keyboard-interactive logins, checks sshd's configuration and
reloads it, which keeps the connections already open.

The runner sends this script on ssh's standard input, with NETWORK as the
box saw the runner connect: its address, or its /64 for IPv6.
USAGE
}

case "${1:-}" in
-h | --help) usage; exit 0 ;;
--allow) [[ -n "${2:-}" ]] || { usage >&2; exit 2; } ;;
*) usage >&2; exit 2 ;;
esac
allow="$2"
case "${allow}" in
*:*) family=ip6 ;;
*) family=ip ;;
esac

if command -v iptables-legacy >/dev/null && command -v ip6tables-legacy >/dev/null; then
	if [[ "${family}" == ip6 ]]; then
		ours=ip6tables-legacy other=iptables-legacy
	else
		ours=iptables-legacy other=ip6tables-legacy
	fi
	"${ours}" -I INPUT 1 -p tcp --dport 22 -s "${allow}" -j ACCEPT
	"${ours}" -I INPUT 2 -p tcp --dport 22 -j DROP
	"${other}" -I INPUT 1 -p tcp --dport 22 -j DROP
	echo "lockdown: port 22 open to ${allow} alone, with iptables-legacy"
elif command -v nft >/dev/null; then
	nft delete table inet botropolis 2>/dev/null || true
	nft -f - <<NFT
table inet botropolis {
	chain ssh {
		type filter hook input priority -10; policy accept;
		tcp dport 22 ${family} saddr ${allow} accept
		tcp dport 22 drop
	}
}
NFT
	echo "lockdown: port 22 open to ${allow} alone, with nftables"
else
	echo "lockdown: neither iptables-legacy nor nft is here, so port 22 cannot be closed to the bots" >&2
	exit 1
fi

config="${SSHD_CONFIG:-/etc/ssh/sshd_config}"
if ! grep -q '^# botropolis lockdown' "${config}"; then
	{
		echo '# botropolis lockdown (item 301): keys only'
		echo 'PasswordAuthentication no'
		echo 'KbdInteractiveAuthentication no'
		cat "${config}"
	} >"${config}.botropolis"
	mv "${config}.botropolis" "${config}"
fi
sshd -t -f "${config}"
systemctl reload ssh 2>/dev/null || kill -HUP "$(cat /run/sshd.pid)"
echo "lockdown: password and keyboard-interactive logins are off"
