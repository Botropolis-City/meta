def ipv6_route():
    try:
        return subprocess.run(['ip', '-6', 'route', 'get', IPV6_PROBE], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL).returncode == 0
    except OSError:
        return False


def secrets(args):
    return SECRETS[args.machine] + (BUCKET_SECRETS if (args.machine, args.command) == ('soak', 'run') else [])


def check(args):
    if args.machine == 'soak' and args.command != 'destroy' and not args.ipv4 and not ipv6_route():
        raise Refused('this machine has no IPv6 route, and the soak box is IPv6 only, so nothing could reach it: '
                      'add IPV4=1 (Robot charges for the address) or run from a network with IPv6. Nothing ordered.')
    missing = [flag for _, attr, flag in secrets(args) if not getattr(args, attr)]
    if (args.machine, args.command) == ('soak', 'run') and not args.bucket_url:
        missing.append('--bucket-url')
    if missing:
        raise Refused('%s %s needs %s: a secret-run reference such as op:Vault/Item/field, never the secret, '
                      'and the bucket\'s URL (set them in testing/machines/.env)'
                      % (args.command, args.machine, ' and '.join(missing)))
    if args.command != 'run':
        return
    needed = ['build', 'stager', 'corpus', 'history'] if args.machine == 'soak' else ['script']
    absent = ['--' + n for n in needed if not getattr(args, n) or not os.path.exists(getattr(args, n))]
    if absent:
        raise Refused('run %s needs %s' % (args.machine, ', '.join(absent)))
    if args.machine == 'soak':
        real = os.path.realpath(os.path.expanduser('~/.claude'))
        history = os.path.realpath(args.history)
        if history == real or history.startswith(real + os.sep):
            raise Refused('--history %s is your own Claude history; nothing of it goes to a rented machine. '
                          'Make a synthetic one with botropolis-demo synth-home (item 248).' % args.history)


def resolve_secrets(args, argv):
    if os.environ.get('MACHINES_RESOLVED') == '1':
        return
    cmd = ['secret-run']
    for name, attr, _ in secrets(args):
        cmd += ['--env', '%s=%s' % (name, getattr(args, attr))]
    cmd += ['--', os.path.realpath(__file__)] + argv
    os.environ['MACHINES_RESOLVED'] = '1'
    os.execvp(cmd[0], cmd)


def state_dir():
    d = os.path.join(os.environ.get('XDG_STATE_HOME') or os.path.expanduser('~/.local/state'), 'botropolis-machines')
    os.makedirs(d, exist_ok=True)
    return d


def out_dir(args, name):
    if args.out:
        d = args.out
    else:
        stamp = datetime.datetime.now().strftime('%Y%m%d-%H%M%S')
        d = os.path.join(os.environ.get('XDG_STATE_HOME') or os.path.expanduser('~/.local/state'),
                         'botropolis-perf', '%s-%s' % (name, stamp))
    os.makedirs(d, exist_ok=True)
    return d


def http(method, url, auth, form=None):
    data = urllib.parse.urlencode(form, doseq=True).encode() if form is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={'Authorization': auth})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            return r.status, json.loads(r.read() or b'{}')
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b'{}')
        except ValueError:
            return e.code, {}


def dedicated_key(args):
    private = private_key(args)
    if os.path.exists(private) and os.path.exists(private + '.pub'):
        return
    if os.path.realpath(args.ssh_key) != os.path.realpath(os.path.expanduser(DEDICATED_KEY + '.pub')):
        raise Refused('--ssh-key %s does not exist; the runner makes only its own key, %s'
                      % (args.ssh_key, DEDICATED_KEY), 2)
    os.makedirs(os.path.dirname(private), mode=0o700, exist_ok=True)
    made = subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'botropolis-machines', '-f', private],
                          stdin=subprocess.DEVNULL)
    if made.returncode != 0:
        raise Refused('ssh-keygen could not make %s' % private, 1)
    os.chmod(private, 0o600)
    say('Made %s, the test machines\' own key, with no passphrase so an overnight run needs nobody.' % private)


def public_key(args):
    with open(args.ssh_key) as f:
        return f.read().strip()


def private_key(args):
    return args.ssh_key[:-4] if args.ssh_key.endswith('.pub') else args.ssh_key


def fingerprint(key):
    digest = hashlib.md5(base64.b64decode(key.split()[1])).hexdigest()
    return ':'.join(digest[i:i + 2] for i in range(0, 32, 2))


def ssh_options(args):
    return ['-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=accept-new',
            '-o', 'UserKnownHostsFile=' + os.path.join(state_dir(), 'known_hosts'),
            '-o', 'IdentityFile=' + private_key(args), '-o', 'ConnectTimeout=10',
            '-o', 'ServerAliveInterval=30', '-o', 'ServerAliveCountMax=10']


def ssh(args, ip, command):
    return subprocess.run(['ssh'] + ssh_options(args) + ['root@' + ip, command]).returncode


def ssh_input(args, ip, command, text):
    return subprocess.run(['ssh'] + ssh_options(args) + ['root@' + ip, command], input=text, text=True).returncode


def ssh_output(args, ip, command):
    done = subprocess.run(['ssh'] + ssh_options(args) + ['root@' + ip, command], capture_output=True, text=True)
    return done.stdout.strip() if done.returncode == 0 else ''


def remote(ip, path):
    return 'root@%s:%s' % ('[%s]' % ip if ':' in ip else ip, path)


def scp(args, *paths):
    return subprocess.run(['scp', '-r'] + ssh_options(args) + list(paths)).returncode


def forget(ip):
    subprocess.run(['ssh-keygen', '-R', ip, '-f', os.path.join(state_dir(), 'known_hosts')],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wait_for_ssh(args, ip):
    deadline = time.monotonic() + float(os.environ.get('MACHINES_SSH_TIMEOUT', '1800'))
    while ssh(args, ip, 'true') != 0:
        if time.monotonic() > deadline:
            raise Refused('%s never answered ssh' % ip, 1)
        time.sleep(POLL)


def on_signal(signum, frame):
    raise KeyboardInterrupt


class Robot:
    def __init__(self):
        self.auth = 'Basic ' + base64.b64encode(
            ('%s:%s' % (os.environ['ROBOT_USER'], os.environ['ROBOT_PASSWORD'])).encode()).decode()
        self.state = os.path.join(state_dir(), 'soak.json')

    def call(self, method, path, form=None, ok=(200, 201)):
        status, body = http(method, ROBOT + path, self.auth, form)
        if status not in ok:
            raise Refused('Robot answered %d to %s %s: %s' % (status, method, path, json.dumps(body)), 1)
        return status, body

    def plan_path(self):
        return os.path.join(state_dir(), 'soak-plan.json')

    def describe(self, p):
        hourly = float(p['price_hourly'])
        return ('auction server %s, %s at %s: EUR %s an hour (EUR %.2f a month), setup fee EUR %.2f; '
                'a 10-hour run is about EUR %.2f' % (p['id'], p['cpu'], p['datacenter'], p['price_hourly'],
                                                     float(p['price']), float(p['price_setup']), 10 * hourly))

    def order_form(self, args, listing, key, test):
        form = {'product_id': listing['id'], 'authorized_key[]': [fingerprint(key)]}
        if args.ipv4:
            form['addon[]'] = ['primary_ipv4']
        if test:
            form['test'] = 'true'
        return form

    def ensure_key(self, args):
        key = public_key(args)
        status, _ = self.call('GET', '/key/' + fingerprint(key), ok=(200, 404))
        if status == 404:
            self.call('POST', '/key', {'name': 'botropolis-machines', 'data': key})
            say('Uploaded your public key %s to Robot, since an order may only name keys it holds.' % fingerprint(key))
        return key

    def plan(self, args):
        status, body = self.call('GET', MARKET + '/product', ok=(200, 404))
        listings = [x['product'] for x in body] if status == 200 and isinstance(body, list) else []
        chosen, why = choose(listings)
        if not chosen:
            raise Refused('no auction server fits the soak: %s. Nothing ordered; ask Aria.' % why, 3)
        say('The soak box: %s (net, VAT extra).' % self.describe(chosen))
        key = self.ensure_key(args)
        self.call('POST', MARKET + '/transaction', self.order_form(args, chosen, key, test=True))
        with open(self.plan_path(), 'w') as f:
            json.dump({'id': chosen['id'], 'cpu': chosen['cpu'], 'datacenter': chosen['datacenter'],
                       'hourly': chosen['price_hourly']}, f)
        say('Robot accepted a test order (not processed) for auction server %s, %s. '
            'apply and run-soak order this listing, and refuse if it is gone or its price has changed.'
            % (chosen['id'], 'with IPv4' if args.ipv4 else 'IPv6 only'))

    def planned(self):
        try:
            with open(self.plan_path()) as f:
                plan = json.load(f)
        except OSError:
            raise Refused('no soak plan here: run `make plan MACHINE=soak` first and read what it chose', 2)
        status, body = self.call('GET', '%s/product/%s' % (MARKET, plan['id']), ok=(200, 404))
        if status == 404:
            raise Refused('auction server %s (%s) is gone since the plan. Nothing ordered; plan again.'
                          % (plan['id'], plan['cpu']), 3)
        listing = body['product']
        if listing.get('price_hourly') is None:
            raise Refused('auction server %s is no longer billed by the hour, so a cancelled server would still '
                          'cost the month. Nothing ordered; plan again.' % plan['id'], 3)
        if float(listing['price_setup']) > 0:
            raise Refused('auction server %s now has a setup fee of EUR %.2f. Nothing ordered; plan again.'
                          % (plan['id'], float(listing['price_setup'])), 3)
        if float(listing['price_hourly']) != float(plan['hourly']):
            raise Refused('auction server %s is now EUR %s an hour, not the EUR %s planned. Nothing ordered; plan again.'
                          % (plan['id'], listing['price_hourly'], plan['hourly']), 3)
        say('The soak box: %s (net, VAT extra).' % self.describe(listing))
        return listing

    def save(self, state):
        with open(self.state, 'w') as f:
            json.dump(state, f)

    def load(self):
        try:
            with open(self.state) as f:
                return json.load(f)
        except OSError:
            return None

    def cancellation(self, state):
        return '/server/%d/cancellation' % state['server_number']

    def book(self, args, state):
        _, body = self.call('GET', self.cancellation(state))
        earliest = body['cancellation']['earliest_cancellation_date']
        wanted = (datetime.datetime.fromtimestamp(time.time() + args.max_hours * 3600, BERLIN).date()
                  + datetime.timedelta(days=1)).isoformat()
        state['booked'], state['earliest'] = max(earliest, wanted), earliest
        self.call('POST', self.cancellation(state), {'cancellation_date': state['booked'], 'reserve_location': 'false'})
        self.save(state)
        say('Booked the box\'s own cancellation for %s (Robot allows %s at the earliest), so it stops billing '
            'with nobody watching: at most about EUR %.2f.' % (state['booked'], earliest, self.cost_until(state)))

    def cost_until(self, state):
        end = datetime.datetime.combine(datetime.date.fromisoformat(state['booked']) + datetime.timedelta(days=1),
                                        datetime.time(), BERLIN)
        return max(0.0, (end.timestamp() - time.time()) / 3600) * float(state['hourly'])

    def apply(self, args):
        listing = self.planned()
        hourly = listing['price_hourly']
        tty = os.environ.get('MACHINES_TTY', '/dev/tty')
        warn('Type the hourly price, %s, to order auction server %s now (anything else stops): ' % (hourly, listing['id']))
        with open(tty) as f:
            typed = f.readline().strip()
        if typed != hourly:
            raise Refused('typed %r, not %s: nothing ordered' % (typed, hourly), 1)
        key = self.ensure_key(args)
        _, body = self.call('POST', MARKET + '/transaction', self.order_form(args, listing, key, test=False))
        state = {'transaction': body['transaction']['id'], 'hourly': hourly, 'listing': listing['id'],
                 'cpu': listing['cpu'], 'datacenter': listing['datacenter']}
        self.save(state)
        os.remove(self.plan_path())
        say('Ordered: transaction %s. It bills from delivery until destroy.' % state['transaction'])
        state = self.delivered(state)
        try:
            self.book(args, state)
        except BaseException:
            warn('could not book the box\'s cancellation, so nothing would stop it without this laptop: cancelling it')
            self.destroy()
            raise
        return state

    def delivered(self, state):
        deadline = time.monotonic() + float(os.environ.get('MACHINES_ORDER_TIMEOUT', '14400'))
        while True:
            _, body = self.call('GET', MARKET + '/transaction/' + state['transaction'])
            t = body['transaction']
            if t['status'] == 'ready':
                break
            if t['status'] == 'cancelled':
                raise Refused('Hetzner cancelled transaction %s' % state['transaction'], 1)
            if time.monotonic() > deadline:
                raise Refused('transaction %s is still %r' % (state['transaction'], t['status']), 1)
            time.sleep(POLL)
        state['server_number'] = t['server_number']
        ip = t.get('server_ip')
        if not ip:
            _, server = self.call('GET', '/server/%d' % t['server_number'])
            ip = server['server']['server_ipv6_net'].split('/')[0] + '2'
        state['ip'] = ip
        self.save(state)
        say('The soak box, server %d, is up at %s and billing; `make destroy MACHINE=soak` cancels it.'
            % (state['server_number'], ip))
        return state

    def destroy(self):
        state = self.load()
        if not state:
            say('No soak box is on order here; nothing to cancel.')
            return
        try:
            if 'server_number' not in state:
                state = self.delivered(state)
            if state.get('booked'):
                status, _ = self.call('DELETE', self.cancellation(state), ok=(200, 409))
                if status == 409:
                    os.remove(self.state)
                    raise Refused('THE SOAK BOX, SERVER %d, RUNS UNTIL ITS BOOKED CANCELLATION ON %s: Robot will not '
                                  'revoke the booking, so it cannot be cancelled sooner. That is up to about EUR %.2f '
                                  'more; see it in Robot.' % (state['server_number'], state['booked'],
                                                             self.cost_until(state)), 1)
            self.call('POST', self.cancellation(state), {'cancellation_date': 'now', 'reserve_location': 'false'})
        except Refused as e:
            if 'BOOKED CANCELLATION' in str(e):
                raise
            warn('THE SOAK BOX IS NOT CANCELLED (%s): cancel it in Robot by hand.' % json.dumps(state))
            raise
        except BaseException:
            warn('THE SOAK BOX IS NOT CANCELLED (%s): cancel it in Robot by hand.' % json.dumps(state))
            raise
        os.remove(self.state)
        say('The soak box, server %d, is cancelled.' % state['server_number'])


def count_history(history):
    projects = os.path.join(history, 'projects')
    sessions, used = 0, 0
    for p in sorted(os.listdir(projects)) if os.path.isdir(projects) else []:
        n = len([f for f in os.listdir(os.path.join(projects, p)) if f.endswith('.jsonl')])
        sessions += n
        used += 1 if n else 0
    return sessions, used


def clock(t):
    return datetime.datetime.fromtimestamp(t).isoformat(timespec='seconds')


class Report:
    def __init__(self, args, ip, out, bucket, run_id):
        self.args, self.ip, self.out, self.bucket, self.run_id = args, ip, out, bucket, run_id
        self.last = None

    def from_bucket(self, staging):
        try:
            data = self.bucket.get(self.run_id + '/report.tar.gz')
        except BucketError as e:
            warn('could not fetch the report from the bucket (%s); trying the box' % e)
            return False
        if data is None:
            return False
        with tarfile.open(fileobj=io.BytesIO(data), mode='r:gz') as tar:
            tar.extractall(staging, filter='data')
        return True

    def fetch(self):
        staging = tempfile.mkdtemp(prefix='.fetching-', dir=self.out)
        try:
            if not self.from_bucket(staging) and scp(self.args, remote(self.ip, REPORT + '/.'), staging) != 0:
                return False
            shutil.copytree(staging, self.out, dirs_exist_ok=True)
        finally:
            shutil.rmtree(staging, ignore_errors=True)
        self.last = time.time()
        return True

    def fetch_until(self, ceiling):
        delay = POLL
        while not self.fetch():
            if time.time() >= ceiling:
                return False
            warn('could not fetch the soak report; retrying in %d s, until the ceiling at %s' % (delay, clock(ceiling)))
            time.sleep(max(0.0, min(delay, ceiling - time.time())))
            delay = min(max(delay * 2, 1), BACKOFF_CAP)
        return True

    def lost(self):
        if self.last is None:
            return ('nothing of the report was fetched, so it is lost here unless the bucket holds it, as %s/'
                    % self.run_id)
        return ('the report since the fetch at %s is lost here unless the bucket holds it, as %s/; what was fetched '
                'is in %s' % (clock(self.last), self.run_id, self.out))


def watch(args, report, ceiling):
    next_fetch = time.time() + FETCH_EVERY
    reachable = True
    while True:
        if time.time() >= ceiling:
            warn('the run reached its ceiling of %g hours at %s with the soak still running' % (args.max_hours, clock(ceiling)))
            return None
        try:
            answer = report.bucket.get(report.run_id + '/exit')
            if not reachable:
                say('the bucket answers again; the soak is still running')
            reachable = True
            if answer is not None and answer.strip().lstrip(b'-').isdigit():
                return int(answer)
        except BucketError as e:
            if reachable:
                warn('could not read the bucket (%s); the box carries on and uploads on its own' % e)
            reachable = False
        if time.time() >= next_fetch:
            if report.fetch():
                say('fetched the report so far, at %s' % clock(report.last))
            else:
                warn('could not fetch the report so far; trying again at the next fetch or the end')
            next_fetch = time.time() + FETCH_EVERY
        time.sleep(POLL)


def run_soak(args):
    robot = Robot()
    out = out_dir(args, 'soak')
    sessions, projects = count_history(args.history)
    report = None
    interrupted = False
    rc = 1
    try:
        state = robot.apply(args)
        ip = state['ip']
        run_id = 'soak-%s-%d' % (datetime.datetime.now().strftime('%Y%m%d-%H%M%S'), state['server_number'])
        ceiling = time.time() + args.max_hours * 3600
        say('The run\'s ceiling: %g hours, until %s, about EUR %.2f; the box is cancelled then, fetched or not.'
            % (args.max_hours, clock(ceiling), args.max_hours * float(state['hourly'])))
        with open(os.path.join(out, 'machine.txt'), 'w') as f:
            f.write('machine: Hetzner auction server %d (listing %s), %s at %s, in Hetzner\'s rescue system '
                    '(Debian, in RAM), EUR %s an hour\n' % (state['server_number'], state['listing'], state['cpu'],
                                                           state['datacenter'], state['hourly']))
            f.write('display: Xorg modesetting on the iGPU, forced 1920x1080 EDID, i3, no blanking, no locker\n')
            f.write('synthetic history: %d sessions in %d projects (botropolis-demo synth-home, item 248); '
                    'nothing from a real ~/.claude\n' % (sessions, projects))
            f.write('started: %s\n' % datetime.datetime.now().isoformat(timespec='seconds'))
            f.write('cancellation booked: %s (Robot\'s earliest: %s), so the box stops with nobody watching\n'
                    % (state['booked'], state['earliest']))
            f.write('report: %s/report.tar.gz in the bucket\n' % run_id)
        forget(ip)
        wait_for_ssh(args, ip)
        with tempfile.TemporaryDirectory() as tmp:
            edid = os.path.join(tmp, 'botropolis-1080p.bin')
            with open(edid, 'wb') as f:
                f.write(edid_1080p())
            if scp(args, os.path.join(HERE, 'soak', 'setup'), os.path.join(HERE, 'soak', 'detached'),
                   os.path.join(HERE, 's3.py'), edid, remote(ip, '/root/')) != 0:
                raise Refused('could not copy the set-up to %s' % ip, 1)
        setup = ssh(args, ip, 'bash /root/setup /root/botropolis-1080p.bin')
        if setup != 0:
            raise Refused('the set-up failed on %s (exit %d); the soak did not start' % (ip, setup), 1)
        mesa = ssh_output(args, ip, "dpkg-query -W -f='${Version}' libgl1-mesa-dri") or 'unknown'
        with open(os.path.join(out, 'machine.txt'), 'a') as f:
            f.write("mesa: %s (Debian's, in the rescue system; not the version on Aria's laptop)\n" % mesa)
        for src, dst in ((os.path.join(ROOT, 'performance'), REMOTE + '/performance'),
                         (args.corpus, REMOTE + '/botropolis/demo'),
                         (args.build, REMOTE + '/build'),
                         (args.stager, REMOTE + '/botropolis-demo'),
                         (args.history, '/home/soak/.claude')):
            if scp(args, src, remote(ip, dst)) != 0:
                raise Refused('could not copy %s to %s' % (src, ip), 1)
        ssh(args, ip, 'chown -R soak: /home/soak')
        key = 'BUCKET_URL=%s\nBUCKET_ID=%s\nBUCKET_SECRET=%s\n' % (
            args.bucket_url, os.environ['BUCKET_WRITE_ID'], os.environ['BUCKET_WRITE_SECRET'])
        if ssh_input(args, ip, 'umask 077 && cat >/root/bucket.env', key) != 0:
            raise Refused('could not give the box its bucket key', 1)
        report = Report(args, ip, out, Bucket(args.bucket_url, os.environ['BUCKET_READ_ID'],
                                              os.environ['BUCKET_READ_SECRET']), run_id)
        command = ['runuser', '-u', 'soak', '--', 'env', 'DISPLAY=:0', 'HOME=/home/soak',
                   'BOTROPOLIS_DEMO=%s/botropolis-demo' % REMOTE,
                   '%s/performance/tools/perf-soak' % REMOTE, '--out', REPORT] \
            + shlex.split(args.soak_flags) + [REMOTE + '/build']
        detached = ['setsid', '-f', 'python3', '/root/detached', '--env', '/root/bucket.env', '--run-id', run_id,
                    '--every', '%g' % FETCH_EVERY, '--out', REPORT, '--'] + command
        if ssh(args, ip, 'rm -f %s && %s </dev/null >%s/detached.log 2>&1'
               % (EXIT_FILE, shlex.join(detached), REPORT)) != 0:
            raise Refused('could not start the soak on %s' % ip, 1)
        say('The soak runs detached on the box and uploads its report every %d minutes; this run watches the '
            'bucket and cancels the box when the soak ends.' % (FETCH_EVERY // 60))
        soak = watch(args, report, ceiling)
        if soak is not None:
            rc = soak
            say('perf-soak exited %d' % rc)
    except KeyboardInterrupt:
        interrupted = True
        raise
    finally:
        try:
            if report is not None:
                if interrupted:
                    fetched = report.fetch()
                else:
                    fetched = report.fetch_until(ceiling)
                if not fetched:
                    warn('could not fetch the soak report before cancelling the box: %s' % report.lost())
                    rc = rc or 1
        finally:
            robot.destroy()
            if os.path.exists(os.path.join(out, 'machine.txt')):
                with open(os.path.join(out, 'machine.txt'), 'a') as f:
                    f.write('cancelled: %s\n' % datetime.datetime.now().isoformat(timespec='seconds'))
    say('Results: %s' % out)
    return rc


class Cloud:
    def __init__(self, args):
        self.args = args
        self.dir = os.path.join(state_dir(), 'wayland-' + args.desktop)
        os.makedirs(self.dir, exist_ok=True)
        cache = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'),
                             'botropolis-machines', 'plugins')
        os.makedirs(cache, exist_ok=True)
        self.env = dict(os.environ, TF_DATA_DIR=os.path.join(self.dir, '.terraform'), TF_PLUGIN_CACHE_DIR=cache)
        self.vars = ['-var', 'desktop=' + args.desktop, '-var', 'ssh_public_key_file=' + args.ssh_key,
                     '-var', 'server_type=' + args.server_type, '-var', 'location=' + (args.location or 'nbg1'),
                     '-var', 'image=' + args.image, '-var', 'ipv4=' + ('true' if args.ipv4 else 'false')]

    def tf(self, *argv, capture=False):
        return subprocess.run(['terraform', '-chdir=' + os.path.join(HERE, 'cloud')] + list(argv),
                              env=self.env, capture_output=capture, text=True)

    def init(self):
        if self.tf('init', '-input=false', '-backend-config=path=' + os.path.join(self.dir, 'terraform.tfstate')).returncode:
            raise Refused('terraform init failed', 1)

    def price(self):
        location = self.args.location or 'nbg1'
        status, body = http('GET', HCLOUD + '/server_types?' + urllib.parse.urlencode({'name': self.args.server_type}),
                             'Bearer ' + os.environ['HCLOUD_TOKEN'])
        types = body.get('server_types') or []
        match = [p for t in types for p in t['prices'] if p['location'] == location]
        if status != 200 or not match:
            raise Refused('no price for %s at %s (Hetzner answered %d)' % (self.args.server_type, location, status), 3)
        hourly = float(match[0]['price_hourly']['net'])
        say('%s at %s for %s: EUR %.4f an hour (net, VAT extra); a 2-hour run is about EUR %.2f.'
            % (self.args.server_type, location, self.args.desktop, hourly, 2 * hourly))

    def plan(self):
        self.price()
        self.init()
        if self.tf('plan', '-input=false', *self.vars).returncode:
            raise Refused('terraform plan failed', 1)

    def apply(self):
        self.price()
        self.init()
        if self.tf('apply', *self.vars).returncode:
            raise Refused('terraform apply failed or was not approved', 1)
        done = self.tf('output', '-json', capture=True)
        outputs = json.loads(done.stdout or '{}')
        ip = outputs['ipv4_address']['value'] if self.args.ipv4 else outputs['ipv6_address']['value']
        say('The %s VM is up at %s and billing; `make destroy MACHINE=wayland DESKTOP=%s` destroys it.'
            % (self.args.desktop, ip, self.args.desktop))
        return ip

    def destroy(self):
        self.init()
        if self.tf('destroy', '-auto-approve', '-input=false', *self.vars).returncode:
            warn('THE %s VM MAY NOT BE DESTROYED: run make destroy MACHINE=wayland DESKTOP=%s again, '
                 'or delete it in the Hetzner console.' % (self.args.desktop.upper(), self.args.desktop))
            return 1
        say('The %s VM is destroyed.' % self.args.desktop)
        return 0


def run_wayland(args):
    cloud = Cloud(args)
    out = out_dir(args, 'wayland-' + args.desktop)
    name = os.path.basename(args.script)
    started = False
    rc = 1
    ip = None
    try:
        ip = cloud.apply()
        with open(os.path.join(out, 'machine.txt'), 'w') as f:
            f.write('machine: Hetzner Cloud %s at %s, %s, %s on Wayland\n'
                    % (args.server_type, args.location or 'nbg1', args.image, args.desktop))
            f.write('started: %s\n' % datetime.datetime.now().isoformat(timespec='seconds'))
        wait_for_ssh(args, ip)
        if ssh(args, ip, 'cloud-init status --wait >/dev/null; /usr/local/bin/wait-for-desktop') != 0:
            raise Refused('the %s session never came up on %s' % (args.desktop, ip), 1)
        if scp(args, args.script, remote(ip, '/home/tester/' + name)) != 0:
            raise Refused('could not copy %s to %s' % (args.script, ip), 1)
        started = True
        command = ['runuser', '-u', 'tester', '--', 'env', 'XDG_RUNTIME_DIR=/run/user/1000',
                   'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus', 'WAYLAND_DISPLAY=wayland-0',
                   'RESULTS=/home/tester/results', 'bash', '/home/tester/' + name]
        rc = ssh(args, ip, 'mkdir -p /home/tester/results && chown tester: /home/tester/results /home/tester/%s && %s'
                 % (shlex.quote(name), shlex.join(command)))
        say('%s exited %d' % (name, rc))
    finally:
        try:
            if started and scp(args, remote(ip, '/home/tester/results/.'), out) != 0:
                warn('could not fetch the results from the VM')
        finally:
            if cloud.destroy() != 0:
                rc = rc or 1
    say('Results: %s' % out)
    return rc


def main(argv):
    if not argv or argv[0] in ('-h', '--help', 'help'):
        print(USAGE)
        return 0
    args = parse(argv)
    try:
        check(args)
        dedicated_key(args)
        resolve_secrets(args, argv)
        signal.signal(signal.SIGTERM, on_signal)
        signal.signal(signal.SIGHUP, on_signal)
        if args.machine == 'soak':
            robot = Robot()
            if args.command == 'run':
                return run_soak(args)
            return {'plan': robot.plan, 'apply': robot.apply, 'destroy': lambda _: robot.destroy()}[args.command](args) and 0
        cloud = Cloud(args)
        if args.command == 'run':
            return run_wayland(args)
        if args.command == 'destroy':
            return cloud.destroy()
        getattr(cloud, args.command)()
        return 0
    except Refused as e:
        warn('machines: %s' % e)
        return e.code
    except KeyboardInterrupt:
        warn('machines: interrupted')
        return 130


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
